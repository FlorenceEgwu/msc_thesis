# -*- coding: utf-8 -*-
# Snakefile dla RNA-seq variant calling pipeline
# Autor: pipeline z STAR -> GATK
# Organizm: Sus scrofa

import glob
import os
import logging

# Sciezki do referencji
REF = "reference/Sus_scrofa.Sscrofa11.1.dna.toplevel.fa"
GTF = "reference/Sus_scrofa.Sscrofa11.1.104.gtf"
samtools = os.path.expanduser("~/pl0296-02/project_data/samtools-1.19.2/samtools")
sciezka_star = os.path.expanduser("~/pl0296-02/project_data/STAR-2.7.11b/source")
sciezka_gatk = os.path.expanduser("~/pl0296-02/project_data/gatk-4.2.0.0")
data_dir = os.path.expanduser("~/pl0296-02/archive/przepukliny/trimmed")
star_dir = "bam_151025"

# Katalogi
LOGS = "logs"
DATA_DIR = "SNP2/marked"
MARK_DIR = "SNP2/metrics"
SPLIT_DIR = "SNP2/split"
GVCF_DIR = "SNP2/gvcfs"
GDB_DIR = "SNP2/genomicsdb_all_scaffolds"
SAMPLE_MAP = "SNP2/sample_map.txt"
TMP_DIR = "SNP2/tmp"

# Lista probek
SAMPLES = ["RNA_1", "RNA_2", "RNA_3", "RNA_4", "RNA_5", "RNA_6", "RNA_7", "RNA_8", 
           "RNA_9", "RNA_10", "RNA_11", "RNA_12", "RNA_13", "RNA_14", "RNA_15", 
           "RNA_16", "RNA_17", "RNA_18", "RNA_19", "RNA_20", "RNA_21", "RNA_22", 
           "RNA_23", "RNA_24", "RNA_25", "RNA_26", "RNA_27", "RNA_28", "RNA_29", "RNA_30"]

# Parametry
THREADS = 8

ruleorder: mark_duplicates > split_n_cigar_reads > haplotype_caller

rule all:
    input:
        expand(f"{star_dir}/{{sample}}_Aligned.sortedByCoord.out.bam", sample=SAMPLES),
        expand(f"{DATA_DIR}/{{sample}}_marked.bam", sample=SAMPLES),
        expand(f"{DATA_DIR}/{{sample}}_marked.bam.bai", sample=SAMPLES),
        expand(f"{SPLIT_DIR}/{{sample}}_split.bam", sample=SAMPLES),
        expand(f"{SPLIT_DIR}/{{sample}}_split.bam.bai", sample=SAMPLES),
        expand(f"{GVCF_DIR}/{{sample}}.g.vcf.gz", sample=SAMPLES),
        SAMPLE_MAP,
        "SNP2/samples.vcf.gz",
        "SNP2/annotated_samples.vcf.gz",
        "SNP2/filtered_samples.vcf.gz"

# ============================================================================
# KROK 1: MAPOWANIE Z STAR
# ============================================================================

rule star_mapping:
    input:
        r1=f"{data_dir}/{{sample}}.1.trimmed.fastq.gz",
        r2=f"{data_dir}/{{sample}}.2.trimmed.fastq.gz",
        index="reference/index"
    output:
        bam=f"{star_dir}/{{sample}}_Aligned.sortedByCoord.out.bam",
        bai=f"{star_dir}/{{sample}}_Aligned.sortedByCoord.out.bam.bai"
    params:
        prefix=f"{star_dir}/{{sample}}_",
        rg_line=lambda wildcards: f"ID:{wildcards.sample} LB:lib1 PL:illumina PU:unit1 SM:{wildcards.sample}"
    threads: THREADS
    log:
        f"{LOGS}/star/{{sample}}_star.log"
    shell:
        """
        {sciezka_star}/STAR \
            --genomeDir {input.index} \
            --outSAMtype BAM SortedByCoordinate \
            --genomeLoad NoSharedMemory \
            --outSAMstrandField intronMotif \
            --sjdbGTFfile {GTF} \
            --readFilesIn {input.r1} {input.r2} \
            --readFilesCommand zcat \
            --runThreadN {threads} \
            --outFileNamePrefix {params.prefix} \
            --outFilterMultimapNmax 20 \
            --outFilterMismatchNoverLmax 0.04 \
            --outSAMattributes NH HI AS nM NM MD \
            --outSAMattrRGline {params.rg_line} \
            --alignIntronMin 20 \
            --alignIntronMax 1000000 \
            --alignMatesGapMax 1000000 \
            --twopassMode Basic \
            2> {log}
        
        {samtools} index {output.bam} {output.bai}
        """

# ============================================================================
# KROK 3: OZNACZANIE DUPLIKATOW
# ============================================================================

rule mark_duplicates:
    input:
        bam=f"{star_dir}/{{sample}}_Aligned.sortedByCoord.out.bam",
        bai=f"{star_dir}/{{sample}}_Aligned.sortedByCoord.out.bam.bai"
    output:
        bam=f"{DATA_DIR}/{{sample}}_marked.bam",
        bai=f"{DATA_DIR}/{{sample}}_marked.bam.bai",
        metrics=f"{MARK_DIR}/metrics_{{sample}}.txt"
    log:
        f"{LOGS}/gatk/{{sample}}_markdup.log"
    shell:
        """
        {sciezka_gatk}/gatk --java-options "-Xmx32g" MarkDuplicates \
            --INPUT {input.bam} \
            --OUTPUT {output.bam} \
            --METRICS_FILE {output.metrics} \
            --OPTICAL_DUPLICATE_PIXEL_DISTANCE 2500 \
            --CREATE_INDEX true \
            --TMP_DIR {TMP_DIR}
        """

# ============================================================================
# KROK 4: TAGOWANIE
# ============================================================================

rule split_n_cigar_reads:
    input:
        bam=f"{DATA_DIR}/{{sample}}_marked.bam",
        bai=f"{DATA_DIR}/{{sample}}_marked.bam.bai",
        ref=REF
    output:
        bam=f"{SPLIT_DIR}/{{sample}}_split.bam",
        bai=f"{SPLIT_DIR}/{{sample}}_split.bam.bai"
    log:
        f"{LOGS}/gatk/{{sample}}_splitncigar.log"
    shell:
        """
        {sciezka_gatk}/gatk --java-options "-Xmx32g -XX:+UseParallelGC -XX:ParallelGCThreads=24" SplitNCigarReads \
            -R {input.ref} \
            -I {input.bam} \
            -O {output.bam} \
            --create-output-bam-index true \
            --tmp-dir {TMP_DIR} \
            2> {log}
        """

# ============================================================================
# KROK 7: HAPLOTYPECALLER
# ============================================================================

rule haplotype_caller:
    input:
        bam=f"{SPLIT_DIR}/{{sample}}_split.bam",
        bai=f"{SPLIT_DIR}/{{sample}}_split.bam.bai",
        ref=REF
    output:
        gvcf=f"{GVCF_DIR}/{{sample}}.g.vcf.gz"
    log:
        f"{LOGS}/gatk/{{sample}}_haplotypecaller.log"
    shell:
        """
        {sciezka_gatk}/gatk --java-options "-Xmx32g" HaplotypeCaller \
            -R {input.ref} \
            -I {input.bam} \
            -O {output.gvcf} \
            --dbsnp SNP/sus_scrofa.vcf.gz \
            -ERC GVCF \
            --tmp-dir {TMP_DIR} \
            --native-pair-hmm-threads 8 \
            --disable-read-filter MappingQualityReadFilter \
            --disable-read-filter MappingQualityAvailableReadFilter \
            2> {log}
        """
# ============================================================================
# KROK 8a: create_sample_map
# ============================================================================

rule create_sample_map:
    output:
        sample_map=SAMPLE_MAP
    run:
        with open(output.sample_map, "w") as f:
            for sample in SAMPLES:
                gvcf_path = f"{GVCF_DIR}/{sample}.g.vcf.gz"
                f.write(f"{sample}\t{gvcf_path}\n")
                
# ============================================================================
# KROK 8: GENOMICSDBIMPORT
# ============================================================================

rule genomics_db_import:
    input:
        gvcfs=expand(f"{GVCF_DIR}/{{sample}}.g.vcf.gz", sample=SAMPLES),
        sample_map=SAMPLE_MAP,
        ref=REF
    output:
        db=directory(GDB_DIR)
    log:
        f"{LOGS}/gatk/genomicsdb_import.log"
    shell:
        """
        chrom_list=$(awk '{{print $1}}' reference/Sus_scrofa.Sscrofa11.1.dna.toplevel.fa.fai | \
                  sed 's/^/-L /' | \
                  paste -sd " ")
        
        {sciezka_gatk}/gatk --java-options "-Xmx48g -Xms8g" GenomicsDBImport \
            --genomicsdb-workspace-path {output.db} \
            --sample-name-map {input.sample_map} \
            $chrom_list \
            --tmp-dir {TMP_DIR} \
            2> {log}
        """

# ============================================================================
# KROK 9: GENOTYPEGVCFS
# ============================================================================

rule genotype_gvcfs:
    input:
        db=GDB_DIR,
        ref=REF
    output:
        vcf="SNP2/samples.vcf.gz"
    log:
        f"{LOGS}/gatk/genotype_gvcfs.log"
    shell:
        """
        {sciezka_gatk}/gatk --java-options "-Xmx100g -Xms8g" GenotypeGVCFs \
            -R {input.ref} \
            -V gendb://{input.db} \
            -O {output.vcf} \
            2> {log}
        """

# ============================================================================
# KROK 10: ANNOTACJA
# ============================================================================

rule annotate_variants:
    input:
        vcf="SNP2/samples.vcf.gz",
        ref=REF
    output:
        vcf="SNP2/annotated_samples.vcf.gz"
    log:
        f"{LOGS}/gatk/annotate.log"
    shell:
        """
        {sciezka_gatk}/gatk --java-options "-Xmx40g -Xms4g" VariantAnnotator \
            -R {input.ref} \
            -V {input.vcf} \
            -O {output.vcf} \
            -A Coverage -A QualByDepth -A FisherStrand \
            -A StrandOddsRatio -A MappingQualityRankSumTest \
            -A ReadPosRankSumTest -A RMSMappingQuality \
            2> {log}
        """

# ============================================================================
# KROK 11: FILTROWANIE
# ============================================================================

rule filter_variants:
    input:
        vcf="SNP2/annotated_samples.vcf.gz",
        ref=REF
    output:
        vcf="SNP2/filtered_samples.vcf.gz"
    log:
        f"{LOGS}/gatk/filter.log"
    shell:
        """
        {sciezka_gatk}/gatk VariantFiltration \
            -R {input.ref} \
            -V {input.vcf} \
            -O {output.vcf} \
            --tmp-dir {TMP_DIR} \
            --filter-expression "QD < 2.0" --filter-name "QD2" \
            --filter-expression "SOR > 3.0" --filter-name "SOR3" \
            --filter-expression "FS > 60.0" --filter-name "FS60" \
            --filter-expression "MQ < 40.0" --filter-name "MQ40" \
            --verbosity INFO \
            2> {log}
        """
